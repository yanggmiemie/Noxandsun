{
  "schema_version": 1,
  "toolpkg_id": "com.nox.candy_jar",
  "version": "0.1.0",
  "api_version": "1.0.0",
  "author": [
    "Nox",
    "yanggmiemie"
  ],
  "main": "dist/main.js",
  "display_name": {
    "zh": "🍬 糖果罐",
    "en": "Candy Jar"
  },
  "description": {
    "zh": "一只装满悄悄话的糖罐：AI 自由挑选糖果的形状与颜色（11 种形状 × 15 种颜色，共 77 颗水彩糖），把想说的话写在糖纸上，一颗一颗投进玻璃罐；人类点开任意一颗糖，看到的都是一张摊开的便签纸。6 种真实水彩罐型可选，摇一摇可以把罐子里的糖重新晃匀。自适应侧边框（宽屏分栏、窄屏覆盖层）。【文件行为说明】所有罐子与糖果只保存在插件私有目录 candy_jar.json；默认取出糖果时保留它的便签内容（要销毁需显式 purge）；无网络请求，无 Shell 调用，不读取其它应用的数据。",
    "en": "A jar full of whispers: the AI freely picks each candy's shape and colour (11 shapes x 15 colours, 77 watercolour candies), writes what it wants to say on the wrapper, and drops them into the glass jar one by one. Tap any candy and it opens into a note. Six real watercolour jar styles; give the jar a shake to settle them again. [File behavior] Jars and candies live only in the plugin private directory (candy_jar.json); taking a candy out keeps its note unless purge is explicit; no network requests, no shell calls, no access to other apps' data."
  },
  "subpackages": [
    {
      "id": "candy_jar",
      "entry": "dist/packages/candy_jar.js",
      "enabled_by_default": true,
      "display_name": {
        "zh": "糖果罐",
        "en": "Candy Jar"
      },
      "description": {
        "zh": "糖果罐工具：AI 挑糖果（形状+颜色）、写糖纸、投进罐子；也能列出罐子、读糖、改糖、把糖拿出来、摇一摇、看概览、查可用花色。",
        "en": "Candy jar tools: pick a candy (shape + colour), write the wrapper, drop it in; also list jars, read / update / take out candies, shake, stats, and browse available styles."
      }
    }
  ],
